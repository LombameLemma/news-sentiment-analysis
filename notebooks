# ==============================
# STOCK TECHNICAL ANALYSIS PIPELINE
# ==============================

import pandas as pd
import matplotlib.pyplot as plt

# ------------------------------
# 1. LOAD DATA
# ------------------------------
df = pd.read_csv("../data/raw/stock_data.csv")

df['Date'] = pd.to_datetime(df['Date'], errors='coerce')
df = df.sort_values('Date')

cols = ['Open', 'High', 'Low', 'Close', 'Volume']
for col in cols:
    df[col] = pd.to_numeric(df[col], errors='coerce')

df = df.fillna(method='ffill').dropna()

# ------------------------------
# 2. PYNANCE FINANCIAL METRICS
# ------------------------------
import pynance as pn

# Daily returns
df['Returns'] = df['Close'].pct_change()

# Volatility (rolling)
df['Volatility_20'] = df['Returns'].rolling(20).std()

# Cumulative returns
df['Cumulative_Returns'] = (1 + df['Returns']).cumprod()

# ------------------------------
# 3. MOVING AVERAGES (SMA + EMA)
# ------------------------------
df['SMA_20'] = df['Close'].rolling(20).mean()
df['SMA_50'] = df['Close'].rolling(50).mean()

df['EMA_20'] = df['Close'].ewm(span=20, adjust=False).mean()
df['EMA_50'] = df['Close'].ewm(span=50, adjust=False).mean()

# ------------------------------
# 4. RSI (RELATIVE STRENGTH INDEX)
# ------------------------------
delta = df['Close'].diff()

gain = (delta.where(delta > 0, 0)).rolling(14).mean()
loss = (-delta.where(delta < 0, 0)).rolling(14).mean()

rs = gain / loss
df['RSI'] = 100 - (100 / (1 + rs))

# ------------------------------
# 5. MACD (MOMENTUM INDICATOR)
# ------------------------------
df['EMA_12'] = df['Close'].ewm(span=12, adjust=False).mean()
df['EMA_26'] = df['Close'].ewm(span=26, adjust=False).mean()

df['MACD'] = df['EMA_12'] - df['EMA_26']
df['MACD_signal'] = df['MACD'].ewm(span=9, adjust=False).mean()
df['MACD_hist'] = df['MACD'] - df['MACD_signal']

# ==============================
# VISUALIZATION SECTION
# ==============================

# ------------------------------
# 6. PRICE + MOVING AVERAGES
# ------------------------------
plt.figure(figsize=(14,6))
plt.plot(df['Close'], label='Close Price')
plt.plot(df['SMA_20'], label='SMA 20')
plt.plot(df['SMA_50'], label='SMA 50')
plt.title("Stock Price with Moving Averages")
plt.legend()
plt.show()

# ------------------------------
# 7. RSI PLOT
# ------------------------------
plt.figure(figsize=(14,4))
plt.plot(df['RSI'], label='RSI')
plt.axhline(70, color='red', linestyle='--')
plt.axhline(30, color='green', linestyle='--')
plt.title("RSI Indicator")
plt.legend()
plt.show()

# ------------------------------
# 8. MACD PLOT
# ------------------------------
plt.figure(figsize=(14,5))
plt.plot(df['MACD'], label='MACD')
plt.plot(df['MACD_signal'], label='Signal Line')
plt.bar(df.index, df['MACD_hist'], label='Histogram')
plt.title("MACD Indicator")
plt.legend()
plt.show()

# ------------------------------
# 9. VOLATILITY VISUALIZATION
# ------------------------------
plt.figure(figsize=(14,5))
plt.plot(df['Volatility_20'], label='20-day Volatility')
plt.title("Market Volatility")
plt.legend()
plt.show()

# ------------------------------
# 10. FINAL CHECK
# ------------------------------
df[['Date','Close','SMA_20','SMA_50','RSI','MACD']].tail()