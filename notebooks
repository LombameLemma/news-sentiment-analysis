# ============================================
# STOCK + NEWS SENTIMENT ANALYSIS PIPELINE
# ============================================

# ------------------------------
# 1. IMPORT LIBRARIES
# ------------------------------
import pandas as pd
import matplotlib.pyplot as plt
from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer

# ============================================
# STOCK DATA PROCESSING
# ============================================

# ------------------------------
# 2. LOAD STOCK DATA
# ------------------------------
stock_df = pd.read_csv("../data/raw/stock_data.csv")

# ------------------------------
# 3. CLEAN STOCK DATA
# ------------------------------
# Convert dates
stock_df['Date'] = pd.to_datetime(
    stock_df['Date'],
    errors='coerce'
)

# Sort by date
stock_df = stock_df.sort_values('Date')

# Convert numeric columns
cols = ['Open', 'High', 'Low', 'Close', 'Volume']

for col in cols:
    stock_df[col] = pd.to_numeric(
        stock_df[col],
        errors='coerce'
    )

# Handle missing values
stock_df = stock_df.ffill().dropna()

# ============================================
# TECHNICAL ANALYSIS
# ============================================

# ------------------------------
# 4. DAILY RETURNS (%)
# ------------------------------
stock_df['daily_return'] = (
    (stock_df['Close'] - stock_df['Close'].shift(1))
    / stock_df['Close'].shift(1)
) * 100

# ------------------------------
# 5. VOLATILITY
# ------------------------------
stock_df['Volatility_20'] = (
    stock_df['daily_return']
    .rolling(20)
    .std()
)

# ------------------------------
# 6. CUMULATIVE RETURNS
# ------------------------------
stock_df['Cumulative_Returns'] = (
    1 + (stock_df['daily_return'] / 100)
).cumprod()

# ------------------------------
# 7. MOVING AVERAGES
# ------------------------------
stock_df['SMA_20'] = (
    stock_df['Close']
    .rolling(20)
    .mean()
)

stock_df['SMA_50'] = (
    stock_df['Close']
    .rolling(50)
    .mean()
)

stock_df['EMA_20'] = (
    stock_df['Close']
    .ewm(span=20, adjust=False)
    .mean()
)

stock_df['EMA_50'] = (
    stock_df['Close']
    .ewm(span=50, adjust=False)
    .mean()
)

# ------------------------------
# 8. RSI
# ------------------------------
delta = stock_df['Close'].diff()

gain = (
    delta.where(delta > 0, 0)
    .rolling(14)
    .mean()
)

loss = (
    -delta.where(delta < 0, 0)
    .rolling(14)
    .mean()
)

rs = gain / loss

stock_df['RSI'] = (
    100 - (100 / (1 + rs))
)

# ------------------------------
# 9. MACD
# ------------------------------
stock_df['EMA_12'] = (
    stock_df['Close']
    .ewm(span=12, adjust=False)
    .mean()
)

stock_df['EMA_26'] = (
    stock_df['Close']
    .ewm(span=26, adjust=False)
    .mean()
)

stock_df['MACD'] = (
    stock_df['EMA_12']
    - stock_df['EMA_26']
)

stock_df['MACD_signal'] = (
    stock_df['MACD']
    .ewm(span=9, adjust=False)
    .mean()
)

stock_df['MACD_hist'] = (
    stock_df['MACD']
    - stock_df['MACD_signal']
)

# ============================================
# VISUALIZATIONS
# ============================================

# ------------------------------
# 10. PRICE + MOVING AVERAGES
# ------------------------------
plt.figure(figsize=(14,6))

plt.plot(
    stock_df['Date'],
    stock_df['Close'],
    label='Close Price'
)

plt.plot(
    stock_df['Date'],
    stock_df['SMA_20'],
    label='SMA 20'
)

plt.plot(
    stock_df['Date'],
    stock_df['SMA_50'],
    label='SMA 50'
)

plt.title("Stock Price with Moving Averages")
plt.xlabel("Date")
plt.ylabel("Price")
plt.legend()

plt.show()

# ------------------------------
# 11. RSI PLOT
# ------------------------------
plt.figure(figsize=(14,4))

plt.plot(
    stock_df['Date'],
    stock_df['RSI'],
    label='RSI'
)

plt.axhline(
    70,
    color='red',
    linestyle='--'
)

plt.axhline(
    30,
    color='green',
    linestyle='--'
)

plt.title("RSI Indicator")
plt.xlabel("Date")
plt.ylabel("RSI")
plt.legend()

plt.show()

# ------------------------------
# 12. MACD PLOT
# ------------------------------
plt.figure(figsize=(14,5))

plt.plot(
    stock_df['Date'],
    stock_df['MACD'],
    label='MACD'
)

plt.plot(
    stock_df['Date'],
    stock_df['MACD_signal'],
    label='Signal Line'
)

plt.bar(
    stock_df['Date'],
    stock_df['MACD_hist'],
    label='Histogram'
)

plt.title("MACD Indicator")
plt.xlabel("Date")
plt.ylabel("MACD")
plt.legend()

plt.show()

# ------------------------------
# 13. VOLATILITY PLOT
# ------------------------------
plt.figure(figsize=(14,5))

plt.plot(
    stock_df['Date'],
    stock_df['Volatility_20'],
    label='20-Day Volatility'
)

plt.title("Market Volatility")
plt.xlabel("Date")
plt.ylabel("Volatility")
plt.legend()

plt.show()

# ============================================
# NEWS SENTIMENT ANALYSIS
# ============================================

# ------------------------------
# 14. LOAD NEWS DATA
# ------------------------------
news_df = pd.read_csv("../data/raw/news_data.csv")

# ------------------------------
# 15. CLEAN NEWS DATA
# ------------------------------
news_df['date'] = pd.to_datetime(
    news_df['date'],
    errors='coerce'
)

# Normalize dates
news_df['news_date'] = (
    news_df['date']
    .dt.date
)

stock_df['trading_date'] = (
    stock_df['Date']
    .dt.date
)

# Convert back to datetime
news_df['news_date'] = pd.to_datetime(
    news_df['news_date']
)

stock_df['trading_date'] = pd.to_datetime(
    stock_df['trading_date']
)

# ============================================
# DATE ALIGNMENT
# ============================================

# ------------------------------
# 16. TRADING CALENDAR
# ------------------------------
trading_days = (
    stock_df[['trading_date']]
    .drop_duplicates()
    .sort_values('trading_date')
)

# ------------------------------
# 17. ALIGN NEWS TO TRADING DAYS
# ------------------------------
aligned_news = pd.merge_asof(
    news_df.sort_values('news_date'),
    trading_days.sort_values('trading_date'),
    left_on='news_date',
    right_on='trading_date',
    direction='forward'
)

aligned_news.rename(
    columns={
        'trading_date': 'matched_trading_day'
    },
    inplace=True
)

# ============================================
# SENTIMENT ANALYSIS
# ============================================

# ------------------------------
# 18. INITIALIZE VADER
# ------------------------------
analyzer = SentimentIntensityAnalyzer()

# ------------------------------
# 19. CALCULATE SENTIMENT SCORES
# ------------------------------
# Replace 'headline' if your column name differs

aligned_news['sentiment'] = (
    aligned_news['headline']
    .astype(str)
    .apply(
        lambda x:
        analyzer.polarity_scores(x)['compound']
    )
)

# ============================================
# DAILY SENTIMENT AGGREGATION
# ============================================

# ------------------------------
# 20. AVERAGE DAILY SENTIMENT
# ------------------------------
daily_sentiment = (
    aligned_news
    .groupby('matched_trading_day')['sentiment']
    .mean()
    .reset_index()
)

daily_sentiment.rename(
    columns={
        'matched_trading_day': 'Date'
    },
    inplace=True
)

# ============================================
# MERGE SENTIMENT + RETURNS
# ============================================

# ------------------------------
# 21. PREPARE RETURNS DATA
# ------------------------------
returns_df = stock_df[
    ['Date', 'daily_return']
]

# ------------------------------
# 22. MERGE DATASETS
# ------------------------------
merged_df = pd.merge(
    daily_sentiment,
    returns_df,
    on='Date',
    how='inner'
)

# ============================================
# PEARSON CORRELATION
# ============================================

# ------------------------------
# 23. CALCULATE CORRELATION
# ------------------------------
correlation = merged_df['sentiment'].corr(
    merged_df['daily_return']
)

print("\nPearson Correlation Coefficient:")
print(correlation)

# ============================================
# SCATTER PLOT
# ============================================

# ------------------------------
# 24. VISUALIZE CORRELATION
# ------------------------------
plt.figure(figsize=(8,5))

plt.scatter(
    merged_df['sentiment'],
    merged_df['daily_return']
)

plt.title(
    "Sentiment vs Daily Stock Returns"
)

plt.xlabel(
    "Average Daily Sentiment"
)

plt.ylabel(
    "Daily Stock Return (%)"
)

# Correlation annotation
plt.text(
    0.05,
    0.95,
    f'Correlation = {correlation:.4f}',
    transform=plt.gca().transAxes,
    fontsize=12,
    verticalalignment='top'
)

plt.show()

# ============================================
# SENTIMENT CLASSIFICATION
# ============================================

# ------------------------------
# 25. CLASSIFY SENTIMENT
# ------------------------------
def classify_sentiment(score):

    if score > 0.05:
        return 'Positive'

    elif score < -0.05:
        return 'Negative'

    else:
        return 'Neutral'

merged_df['sentiment_category'] = (
    merged_df['sentiment']
    .apply(classify_sentiment)
)

# ============================================
# CATEGORY ANALYSIS
# ============================================

# ------------------------------
# 26. AVERAGE RETURNS BY CATEGORY
# ------------------------------
category_returns = (
    merged_df
    .groupby('sentiment_category')['daily_return']
    .mean()
)

print("\nAverage Return by Sentiment Category:")
print(category_returns)

# ============================================
# BAR CHART
# ============================================

# ------------------------------
# 27. VISUALIZE CATEGORY RETURNS
# ------------------------------
plt.figure(figsize=(7,5))

category_returns.plot(
    kind='bar'
)

plt.title(
    "Average Daily Return by Sentiment Category"
)

plt.xlabel(
    "Sentiment Category"
)

plt.ylabel(
    "Average Daily Return (%)"
)

plt.xticks(rotation=0)

plt.show()

# ============================================
# INTERPRETATION
# ============================================

# ------------------------------
# 28. INTERPRET CORRELATION
# ------------------------------
if correlation > 0:
    print("\nPositive relationship detected.")

elif correlation < 0:
    print("\nNegative relationship detected.")

else:
    print("\nNo relationship detected.")

# ============================================
# FINAL OUTPUT CHECK
# ============================================

# ------------------------------
# 29. FINAL STOCK DATA
# ------------------------------
print("\nFinal Stock Data:")

print(
    stock_df[
        [
            'Date',
            'Close',
            'daily_return',
            'SMA_20',
            'SMA_50',
            'RSI',
            'MACD'
        ]
    ].tail()
)

# ------------------------------
# 30. FINAL MERGED DATA
# ------------------------------
print("\nMerged Dataset:")

print(
    merged_df.head()
)